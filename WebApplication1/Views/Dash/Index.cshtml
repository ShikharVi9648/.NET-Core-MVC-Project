@using WebApplication1.Dto
@model List<ProductDto>





    <div class="container mt-5">

        <div class="card shadow">

            <!-- Header -->
            <div class="card-header bg-white">

                <div class="d-flex justify-content-between align-items-center">

                    <h3 class="mb-0">
                        Product Dashboard
                    </h3>

                    <a class="btn btn-success" asp-action="ProductForm">
                        + Add Product
                    </a>

                </div>

            </div>


            <!-- Table -->
            <div class="card-body">

                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>Product Name</th>
                            <th>Description</th>
                            <th>Price</th>
                            <th>Color</th>
                            <th>Action</th>
                        </tr>

                    </thead>

                    <tbody>
                    @if (Model.Count > 0)
                    {
                        foreach(var Product in Model)
                        {
                            

                            <!-- Product 1 -->
                                <tr>
                                    <td>@Product.ProductName</td>

                                    <td>
                                       @Product.Description
                                    </td>

                                    <td>
                                        ₹ @Product.Price
                                    </td>

                                    <td>
                                        @Product.Color
                                    </td>

                                    <td>
                                    <a class="btn btn-primary btn-sm" asp-action="UpdateProductForm" asp-route-id="@Product.Id">
                                            Edit
                                        </a>

                                        <a class="btn btn-danger btn-sm" asp-action="DeleteProduct" asp-route-ProductId="@Product.Id">
                                            Delete
                                        </a>
                                    </td>
                                </tr>


                        }
                    }
                    else
                    {
                        <tr>No Product in this table</tr>
                    }
                </tbody>

                </table>

            </div>

        </div>

    </div>
